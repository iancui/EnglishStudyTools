// LinguaStep Prisma schema for MySQL 5.7
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String    @id @default(uuid()) @db.VarChar(36)
  username     String    @unique @db.VarChar(50)
  email        String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         Role      @default(USER)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  dictionaryConfig   UserDictionaryConfig?
  ownedDictionaries  Dictionary[]           @relation("UserOwnedDictionaries")
  wordProgresses     UserWordProgress[]
  sentenceProgresses UserSentenceProgress[]
  studySessions      StudySession[]
  learningRecords    LearningRecord[]
  reviewRecords      ReviewRecord[]

  @@map("users")
}


model RbacRole {
  id             String                 @id @db.VarChar(64)
  displayName    String                 @map("display_name") @db.VarChar(100)
  description    String?                @db.VarChar(255)
  isSystem       Boolean                @default(true) @map("is_system")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  users          UserRoleAssignment[]
  permissions    RbacRolePermission[]

  @@map("roles")
}

model RbacPermission {
  id             String                 @id @db.VarChar(100)
  displayName    String                 @map("display_name") @db.VarChar(100)
  resource       String                 @db.VarChar(50)
  action         String                 @db.VarChar(50)
  description    String?                @db.VarChar(255)
  createdAt      DateTime               @default(now()) @map("created_at")
  roles          RbacRolePermission[]

  @@map("permissions")
}

model UserRoleAssignment {
  userId         String   @map("user_id") @db.VarChar(36)
  roleId         String   @map("role_id") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           RbacRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RbacRolePermission {
  roleId         String         @map("role_id") @db.VarChar(64)
  permissionId   String         @map("permission_id") @db.VarChar(100)
  createdAt      DateTime       @default(now()) @map("created_at")
  role           RbacRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission     RbacPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

enum DictionaryOwnerType {
  SYSTEM
  USER
}

enum DictionaryStatus {
  ACTIVE
  INACTIVE
}

model Dictionary {
  id          String              @id @default(uuid()) @db.VarChar(36)
  name        String              @db.VarChar(100)
  code        String              @unique @db.VarChar(50)
  description String?             @db.Text
  ownerType   DictionaryOwnerType @default(SYSTEM) @map("owner_type")
  ownerUserId String?             @map("owner_user_id") @db.VarChar(36)
  isSystem    Boolean             @default(false) @map("is_system")
  isPublic    Boolean             @default(true) @map("is_public")
  status      DictionaryStatus    @default(ACTIVE)
  wordCount   Int                 @default(0) @map("word_count")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  ownerUser       User?            @relation("UserOwnedDictionaries", fields: [ownerUserId], references: [id], onDelete: SetNull)
  dictionaryWords DictionaryWord[]
  chapters      DictionaryChapter[]
  studySessions      StudySession[]
  sentenceDictionaries DictionarySentence[]

  @@index([ownerUserId])
  @@index([ownerType])
  @@map("dictionary")
}

model DictionaryChapter {
  id           String   @id @db.VarChar(36)
  dictionaryId String   @map("dictionary_id") @db.VarChar(36)
  name         String   @db.VarChar(255)
  code         String?  @db.VarChar(100)
  description  String?  @db.Text
  sequenceNo   Int      @default(1) @map("sequence_no")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  dictionary Dictionary           @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)
  words      DictionaryWord[]
  sentences  DictionarySentence[]

  @@index([dictionaryId, sequenceNo])
  @@map("dictionary_chapter")
}

model DictionaryWord {
  id               String   @id @default(uuid()) @db.VarChar(36)
  dictionaryId     String   @map("dictionary_id") @db.VarChar(36)
  chapterId        String?  @map("chapter_id") @db.VarChar(36)
  wordId           String   @map("word_id") @db.VarChar(36)
  sequence         Int      @default(1) @map("sequence_no")
  isActive         Boolean  @default(true) @map("is_active")
  definitionSource String?  @map("definition_source") @db.VarChar(255)
  createdAt        DateTime @default(now()) @map("created_at")

  dictionary Dictionary           @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)
  chapter    DictionaryChapter?   @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  word       Word                 @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([dictionaryId, wordId])
  @@index([dictionaryId, sequence])
  @@index([wordId])
  @@map("dictionary_word")
}

model Word {
  id          String   @id @default(uuid()) @db.VarChar(36)
  text        String   @unique @db.VarChar(100)
  phoneticUk  String?  @map("phonetic_uk") @db.VarChar(100)
  phoneticUs  String?  @map("phonetic_us") @db.VarChar(100)
  audioUkUrl  String?  @map("audio_uk_url") @db.VarChar(255)
  audioUsUrl  String?  @map("audio_us_url") @db.VarChar(255)
  pos         String?  @db.VarChar(50)
  difficulty  Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  meanings          WordMeaning[]
  phonics           WordPhonics[]
  sentenceWords     SentenceWord[]
  dictionaryWords   DictionaryWord[]
  studySessionWords StudySessionWord[]
  userProgresses    UserWordProgress[]
  reviewRecords     ReviewRecord[]

  @@index([text])
  @@map("word")
}

model WordMeaning {
  id           String   @id @default(uuid()) @db.VarChar(36)
  wordId       String   @map("word_id") @db.VarChar(36)
  pos          String   @db.VarChar(30)
  definitionCn String   @map("definition_cn") @db.Text
  definitionEn String?  @map("definition_en") @db.Text
  exampleEn    String?  @map("example_en") @db.Text
  exampleCn    String?  @map("example_cn") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@map("word_meaning")
}

model WordPhonics {
  id        String   @id @default(uuid()) @db.VarChar(36)
  wordId    String   @map("word_id") @db.VarChar(36)
  sequence  Int
  text      String   @db.VarChar(50)
  phonetic  String   @db.VarChar(50)
  syllable  String   @db.VarChar(50)
  audioUrl  String?  @map("audio_url") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([wordId, sequence])
  @@index([wordId])
  @@map("word_phonics")
}

model Sentence {
  id          String   @id @default(uuid()) @db.VarChar(36)
  content     String   @db.Text
  translation String   @db.Text
  level       String   @default("A1") @db.VarChar(20)
  audioUrl    String?  @map("audio_url") @db.VarChar(255)
  difficulty  Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  steps          SentenceStep[]
  words          SentenceWord[]
  analyses       SentenceAnalysis[]
  dictionarySentences DictionarySentence[]
  userProgresses UserSentenceProgress[]

  @@map("sentence")
}


model DictionarySentence {
  id           String     @id @default(uuid()) @db.VarChar(36)
  dictionaryId String     @map("dictionary_id") @db.VarChar(36)
  chapterId    String?    @map("chapter_id") @db.VarChar(36)
  sentenceId   String     @map("sentence_id") @db.VarChar(36)
  sequenceNo   Int        @default(1) @map("sequence_no")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")

  dictionary Dictionary           @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)
  chapter    DictionaryChapter?   @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  sentence   Sentence             @relation(fields: [sentenceId], references: [id], onDelete: Cascade)

  @@unique([dictionaryId, sentenceId])
  @@index([dictionaryId, sequenceNo])
  @@map("dictionary_sentence")
}

model SentenceWord {
  id         String   @id @default(uuid()) @db.VarChar(36)
  sentenceId String   @map("sentence_id") @db.VarChar(36)
  wordId     String   @map("word_id") @db.VarChar(36)
  position   Int
  createdAt  DateTime @default(now()) @map("created_at")

  sentence Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  word     Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([sentenceId, position])
  @@index([sentenceId])
  @@index([wordId])
  @@map("sentence_word")
}

enum StepType {
  WORD
  PHRASE
  STRUCTURE
  SENTENCE
}

model SentenceStep {
  id          String   @id @default(uuid()) @db.VarChar(36)
  sentenceId  String   @map("sentence_id") @db.VarChar(36)
  stepNumber  Int      @map("step_number")
  content     String   @db.Text
  translation String   @db.Text
  phonetic    String?  @db.VarChar(255)
  type        StepType @default(WORD)
  audioUrl    String?  @map("audio_url") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  sentence Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)

  @@unique([sentenceId, stepNumber])
  @@index([sentenceId])
  @@map("sentence_step")
}

model SentenceAnalysis {
  id            String   @id @default(uuid()) @db.VarChar(36)
  sentenceId    String   @map("sentence_id") @db.VarChar(36)
  text          String   @db.VarChar(100)
  startPosition Int      @map("start_position")
  endPosition   Int      @map("end_position")
  type          String   @db.VarChar(50)
  explanation   String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  sentence Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)

  @@index([sentenceId])
  @@map("sentence_analysis")
}

model UserDictionaryConfig {
  id                  String   @id @default(uuid()) @db.VarChar(36)
  userId              String   @unique @map("user_id") @db.VarChar(36)
  defaultDictionaryId String?  @map("default_dictionary_id") @db.VarChar(36)
  phoneticType        String   @default("UK") @map("phonetic_type") @db.VarChar(10)
  audioType           String   @default("UK") @map("audio_type") @db.VarChar(10)
  enablePhonics       Boolean  @default(true) @map("enable_phonics")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_dictionary_config")
}

enum ProgressStatus {
  NEW
  LEARNING
  REVIEW
  MASTERED
}

model UserWordProgress {
  id           String         @id @default(uuid()) @db.VarChar(36)
  userId       String         @map("user_id") @db.VarChar(36)
  wordId       String         @map("word_id") @db.VarChar(36)
  status       ProgressStatus @default(NEW)
  learnCount   Int            @default(0) @map("learn_count")
  reviewCount  Int            @default(0) @map("review_count")
  correctCount Int            @default(0) @map("correct_count")
  wrongCount   Int            @default(0) @map("wrong_count")
  streak       Int            @default(0)
  mastery      Int            @default(0)
  lastLearnAt  DateTime?      @map("last_learn_at")
  lastReviewAt DateTime?      @map("last_review_at")
  nextReviewAt DateTime?      @map("next_review_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, status])
  @@index([userId, nextReviewAt])
  @@map("user_word_progress")
}

enum SessionMode {
  LEARN_AND_WRITE
  WRITE_ONLY
}

enum SessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SessionSortMode {
  RANDOM
  SEQUENCE
  REVIEW_FIRST
}

model StudySession {
  id              String          @id @default(uuid()) @db.VarChar(36)
  userId          String          @map("user_id") @db.VarChar(36)
  mode            SessionMode     @default(LEARN_AND_WRITE)
  dictionaryId    String          @map("dictionary_id") @db.VarChar(36)
  totalCount      Int             @map("total_count")
  completedCount  Int             @default(0) @map("completed_count")
  excludeMastered Boolean         @default(true) @map("exclude_mastered")
  sortMode        SessionSortMode @default(RANDOM) @map("sort_mode")
  status          SessionStatus   @default(IN_PROGRESS)
  currentWordIndex Int            @default(0) @map("current_word_index")
  startedAt       DateTime        @default(now()) @map("started_at")
  completedAt     DateTime?       @map("completed_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  dictionary Dictionary         @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)
  words      StudySessionWord[]

  @@index([userId, status])
  @@map("study_session")
}

enum SessionWordStatus {
  LEARN_PENDING
  LEARNED
  WRITE_PENDING
  WRITTEN
  COMPLETED
}

model StudySessionWord {
  id          String            @id @default(uuid()) @db.VarChar(36)
  sessionId   String            @map("session_id") @db.VarChar(36)
  wordId      String            @map("word_id") @db.VarChar(36)
  sequence    Int
  learnStatus SessionWordStatus @default(LEARN_PENDING) @map("learn_status")
  writeStatus SessionWordStatus @default(WRITE_PENDING) @map("write_status")
  completed   Boolean           @default(false)
  isCorrect   Boolean?          @map("is_correct")
  userInput   String?           @map("user_input") @db.VarChar(255)
  learnedAt   DateTime?         @map("learned_at")
  writtenAt   DateTime?         @map("written_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  session StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  word    Word         @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
  @@index([sessionId, completed])
  @@map("study_session_word")
}

model UserSentenceProgress {
  id          String    @id @default(uuid()) @db.VarChar(36)
  userId      String    @map("user_id") @db.VarChar(36)
  sentenceId  String    @map("sentence_id") @db.VarChar(36)
  status      String    @default("IN_PROGRESS") @db.VarChar(20)
  currentStep Int       @default(1) @map("current_step")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentence Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)

  @@unique([userId, sentenceId])
  @@index([userId])
  @@map("user_sentence_progress")
}

model LearningRecord {
  id           String   @id @default(uuid()) @db.VarChar(36)
  userId       String   @map("user_id") @db.VarChar(36)
  itemType     String   @map("item_type") @db.VarChar(20)
  itemId       String   @map("item_id") @db.VarChar(36)
  action       String   @db.VarChar(50)
  isCorrect    Boolean  @default(true) @map("is_correct")
  inputText    String?  @map("input_text") @db.VarChar(255)
  timeSpentSec Int      @default(0) @map("time_spent_sec")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("learning_record")
}

model ReviewRecord {
  id           String   @id @default(uuid()) @db.VarChar(36)
  userId       String   @map("user_id") @db.VarChar(36)
  wordId       String   @map("word_id") @db.VarChar(36)
  intervalDays Float    @map("interval_days")
  nextReviewAt DateTime @map("next_review_at")
  result       String   @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([userId, wordId])
  @@map("review_record")
}
